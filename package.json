{
  "name": "biz-manager",
  "version": "1.0.0",
  "description": "Digital Desk POS & Admin Dashboard",
  "main": "server/index.js",
  "scripts": {
    "build": "npx prisma generate && npx prisma db push --accept-data-loss",
    "start": "npx prisma db push --accept-data-loss && node server/index.js",
    "dev": "node server/index.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.9.0"
  }
}
