datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id         Int        @id @default(autoincrement())
  name       String
  category   Category   @relation(fields: [categoryId], references: [id])
  categoryId Int
  buyPrice   Float
  sellPrice  Float
  stock      Int        @default(0)
  photoUrl   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  saleItems  SaleItem[]
}

model Sale {
  id          Int        @id @default(autoincrement())
  soldAt      DateTime   @default(now())
  totalAmount Float
  totalProfit Float
  items       SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  unitPrice Float
  unitCost  Float
}
